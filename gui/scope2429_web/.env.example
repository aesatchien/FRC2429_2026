# Copy to .env and fill in.  Never commit the real .env (it holds secrets); .gitignore already excludes it.

# ---- Cloudflare Tunnel (docker-compose.yml) -------------------------------------------------------------------------------
# Zero Trust dashboard > Networks > Tunnels > your tunnel > the token shown in the install command
TUNNEL_TOKEN=

# ---- who may use the site -------------------------------------------------------------------------------------------------
# Cloudflare Access (recommended): Zero Trust > Access > Applications > your application.
#   CF_ACCESS_TEAM_DOMAIN is the first part of  <this>.cloudflareaccess.com ;  CF_ACCESS_AUD is the application's "Application Audience (AUD) Tag"
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# Without Access, one shared password (the browser asks for it):  TEAM_PASSWORD=...
# TEAM_PASSWORD=
# Local development only, no login at all:
# ALLOW_NO_AUTH=1

# ---- embedding ------------------------------------------------------------------------------------------------------------
# The sites allowed to show this one in an <iframe>, space separated (this site itself is always allowed).
# Embedding works best when the parent site and this one share a parent domain (www.yourteam.org and scope.yourteam.org): see README.md.
FRAME_ANCESTORS=https://www.yourteam.org

# ---- storage ----------------------------------------------------------------------------------------------------------------
# Where the NAS keeps the data (a dataset path); inside the container it is always /data
DATA_PATH=./data
MAX_UPLOAD_MB=250
# Cloudflare R2, for the rendered MP4s (optional: without it the MP4s stay on the NAS)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
KEEP_LOCAL_VIDEO=1

# ---- rendering ----------------------------------------------------------------------------------------------------------------
# MP4 size: 360 (1280x720), 540 (1920x1080), 720.  Bigger takes longer.
RENDER_HEIGHT=540
SCOPE_CPUS=2
